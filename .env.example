# ─── Server ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Public base URL (used to build absolute file URLs for uploads). No trailing slash.
PUBLIC_BASE_URL=https://your-domain.com

# ─── Postgres ───────────────────────────────────────────────────────────
# Either set DATABASE_URL, or the individual PG* vars.
DATABASE_URL=postgres://landingpage:CHANGE_ME@127.0.0.1:5432/landingpage
# Optional host port used by docker-compose.yml when 5432 is already occupied.
PGHOST_PORT=5432
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=landingpage
# PGPASSWORD=CHANGE_ME
# PGDATABASE=landingpage
PGPOOL_MAX=10
PGSSL=false

# ─── Auth (JWT) ─────────────────────────────────────────────────────────
# Long random string, 32+ chars. Used to sign admin session JWTs.
JWT_SECRET=replace-with-32-plus-char-random-secret
JWT_EXPIRES_IN=12h

# Optional token for POST /api/leads from external landing pages.
LEAD_API_KEY=replace-with-a-long-random-string


# Comma-separated emails auto-promoted to admin on first login.
CRM_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Optional cookie signing secret; defaults to JWT_SECRET when omitted.
# ADMIN_COOKIE_SECRET=replace-with-a-long-random-string

# ─── Google OAuth (optional — "Đăng nhập bằng Google" trên /admin) ──────
# Tạo OAuth Client ID (Web application) trong Google Cloud Console.
# Authorized redirect URI phải khớp chính xác GOOGLE_REDIRECT_URI bên dưới.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# Mặc định suy ra từ PUBLIC_BASE_URL nếu bỏ trống.
# GOOGLE_REDIRECT_URI=https://your-domain.com/admin/auth/google/callback

# ─── Local storage (replaces Supabase Storage) ──────────────────────────
# Physical folder where uploaded files are written.
STORAGE_ROOT=./storage
# URL prefix under which STORAGE_ROOT is served (public, read-only).
STORAGE_PUBLIC_PATH=/storage

# ─── Academic Survey / Hành trình thịnh vượng (optional) ────────────────
# Optional server-only Vimeo metadata access for the dong-tien admin importer.
# Without a token, the importer reads the shared review folder directly.
# VIMEO_ACCESS_TOKEN=your-read-only-vimeo-token
# DONG_TIEN_VIMEO_FOLDER_ID=29758694
# DONG_TIEN_VIMEO_REVIEW_URL=https://vimeo.com/reviews/REVIEW_ID/users/USER_ID/folders/FOLDER_ID
# ACADEMIC_SURVEY_BASE_URL=https://ebila.ai/academic-survey
# ACADEMIC_SURVEY_API_KEY=your-api-key

# ─── Email notifications (optional) ─────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# NOTIFY_EMAIL=your@gmail.com

# ─── Analytics (optional) ───────────────────────────────────────────────
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Shared Google Tag configuration (including /dong-tien and child routes)
# META_BROWSER_PIXEL_ENABLED=true
# GOOGLE_TAG_ENABLED=true
# GTM_CONTAINER_ID=GTM-KBK3JQ3
# Set GTM_CONTAINER_ID empty to use GA_MEASUREMENT_ID directly without GTM.
# FB_PIXEL_ID=XXXXXXXXXXXXXXX

# ─── Meta Conversions API (optional, server-side) ───────────────────────
# META_CAPI_ENABLED=true
# META_DATASET_ID=521486712218027
# META_ACCESS_TOKEN=your_meta_access_token
# META_API_VERSION=v21.0
# META_TEST_EVENT_CODE=TEST12345
# META_CAPI_TIMEOUT_MS=3500

# ─── EverWebinar (optional) ─────────────────────────────────────────────
# EVERWEBINAR_API_KEY=your_everwebinar_api_key
# EVERWEBINAR_WEBINAR_ID=8
# EVERWEBINAR_SCHEDULE=27
# EVERWEBINAR_TIMEZONE=GMT+7
# EVERWEBINAR_DATE=
# EVERWEBINAR_PHONE_COUNTRY_CODE=+84

# ─── Zoom Server-to-Server OAuth (optional) ─────────────────────────────
# ZOOM_ACCOUNT_ID=TcBM9P6BTlCYLWcvZlyMVg
# ZOOM_CLIENT_ID=WslCTctFRt6PZm2_glu6Yg
# ZOOM_CLIENT_SECRET=your_zoom_client_secret
# ZOOM_REDIRECT_URI=https://event.phamthanhbien.com/admin/zoom/oauth/callback
# ZOOM_SYNC_USER_IDS=
