# Server-only internal URL of the existing admin service (loopback/private IPv4 only).
ADMIN_API_URL=http://127.0.0.1:3001
# Must match LEAD_API_KEY in the admin service; leave empty if admin has no key.
LEAD_API_KEY=
# Site address for og:/canonical tags, read at build time; same as SITE_URL of the admin service.
# NEXT_PUBLIC_SITE_URL=https://phamthanhbien.com
# Old hosts sending course pages to NEXT_PUBLIC_SITE_URL with a 301 (as LEGACY_HOSTS there).
# LEGACY_HOSTS=event.phamthanhbien.com
# Disable framework usage telemetry during local development and builds.
NEXT_TELEMETRY_DISABLED=1
